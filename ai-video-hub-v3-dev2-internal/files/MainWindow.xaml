<Window x:Class="AI.VideoHub.V3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AI Video Hub V3.0 RC1" Width="1460" Height="900" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen">
  <Grid Background="#F5F6F8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="330"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="#17191D" Padding="14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="AI Video Hub" Foreground="White" FontSize="20" FontWeight="Bold" Margin="4,4,4,14"/>
          <Button Content="+ 添加 Dola 账号" Height="36" Click="AddDola_Click"/>
          <Button Content="+ 添加豆包账号" Height="36" Margin="0,8,0,0" Click="AddDoubao_Click"/>
          <Button Content="+ 添加千问账号" Height="36" Margin="0,8,0,12" Click="AddQianwen_Click"/>
        </StackPanel>
        <ListBox x:Name="AccountList" Background="#202329" Foreground="White" BorderThickness="0" SelectionChanged="AccountList_SelectionChanged"/>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="130"/></Grid.RowDefinitions>
      <Border Background="White" Padding="12,8"><DockPanel><TextBlock x:Name="PageTitle" Text="请选择账号" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ProtocolStatus" DockPanel.Dock="Right" Foreground="#666" VerticalAlignment="Center"/></DockPanel></Border>
      <wv2:WebView2 x:Name="Browser" Grid.Row="1"/>
      <TextBox x:Name="LogBox" Grid.Row="2" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#101216" Foreground="#D7DCE2" BorderThickness="0" Padding="10"/>
    </Grid>

    <Border Grid.Column="2" Background="White" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="视频任务" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="RC1 只使用当前账号真实观察到的 Dola 提交协议；15 秒必须绑定同一 task_id、同一 VID 和最终实际时长后才会 PASS。" TextWrapping="Wrap" Foreground="#666" Margin="0,6,0,16"/>
        <TextBlock Text="提示词" FontWeight="SemiBold"/>
        <TextBox x:Name="PromptBox" Height="110" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,6,0,12"/>
        <TextBlock Text="画面比例" FontWeight="SemiBold"/>
        <ComboBox x:Name="RatioBox" SelectedIndex="0" Margin="0,6,0,12"><ComboBoxItem Content="16:9"/><ComboBoxItem Content="9:16"/><ComboBoxItem Content="1:1"/></ComboBox>
        <TextBlock Text="时长" FontWeight="SemiBold"/>
        <ComboBox x:Name="DurationBox" SelectedIndex="1" Margin="0,6,0,12"><ComboBoxItem Content="5"/><ComboBoxItem Content="10"/><ComboBoxItem Content="15"/></ComboBox>
        <Button x:Name="SubmitButton" Content="开始生成" Height="42" Click="Submit_Click" IsEnabled="False"/>
        <TextBlock x:Name="SubmitHint" Text="先打开 Dola 账号并正常操作一次，让 V3 学习真实协议。" TextWrapping="Wrap" Foreground="#777" Margin="0,8,0,18"/>
        <Separator/>
        <TextBlock Text="原片/无水印资源" FontSize="16" FontWeight="Bold" Margin="0,16,0,4"/>
        <CheckBox x:Name="RightsCheck" Content="我确认素材为本人创作或已获授权" Margin="0,8,0,8"/>
        <TextBlock x:Name="OriginalInfo" Text="尚未发现明确 original/no_watermark 资源。" TextWrapping="Wrap" Foreground="#666"/>
        <Button Content="保存明确原片" Height="38" Margin="0,10,0,0" Click="DownloadOriginal_Click"/>
        <Button Content="打开下载目录" Height="34" Margin="0,8,0,0" Click="OpenDownloads_Click"/>
        <TextBlock Text="本地去水印（授权素材兜底）" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <Button Content="选择本地视频" Height="34" Click="ChooseLocalVideo_Click"/>
        <TextBlock x:Name="LocalVideoPath" Text="未选择文件" TextWrapping="Wrap" Foreground="#777" Margin="0,6,0,8"/>
        <UniformGrid Columns="4" Margin="0,0,0,6">
          <TextBox x:Name="WatermarkX" Text="0" ToolTip="X" Margin="0,0,4,0"/>
          <TextBox x:Name="WatermarkY" Text="0" ToolTip="Y" Margin="0,0,4,0"/>
          <TextBox x:Name="WatermarkW" Text="200" ToolTip="宽" Margin="0,0,4,0"/>
          <TextBox x:Name="WatermarkH" Text="80" ToolTip="高"/>
        </UniformGrid>
        <TextBlock Text="上面四项依次为 X / Y / 宽 / 高。" Foreground="#777" FontSize="11"/>
        <Button Content="本地处理并导出" Height="36" Margin="0,8,0,0" Click="LocalDelogo_Click"/>
        <Separator Margin="0,18,0,0"/>
        <TextBlock Text="验收规则" FontSize="16" FontWeight="Bold" Margin="0,16,0,6"/>
        <TextBlock Text="15 秒：HTTP 接受不算成功；必须同一 task_id 完成、服务端任务时长=15、同一 VID 原片并由 ffprobe 验证约 15 秒。&#10;原片：普通播放 URL 不算；必须有明确 original/no_watermark 证据。" TextWrapping="Wrap" Foreground="#555"/>
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
</Window>
