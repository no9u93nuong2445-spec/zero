{
  "openapi": "3.1.0",
  "info": {
    "title": "彼岸 AI 媒体任务网关",
    "version": "2.4.0",
    "description": "通过 GitHub repository_dispatch 提交 Google 语音、音乐、视频任务，并通过持久状态账本查询结果。无需 GitHub Issues 权限。"
  },
  "servers": [
    {"url": "https://api.github.com"}
  ],
  "paths": {
    "/repos/no9u93nuong2445-spec/doubao-tts-bridge/dispatches": {
      "post": {
        "operationId": "dispatchMediaJob",
        "summary": "提交 Google 媒体生成任务",
        "description": "GitHub 成功接收 repository_dispatch 时通常返回 HTTP 204 且无正文。204/空响应代表已接受，不得重复提交同一个 request_id。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event_type", "client_payload"],
                "properties": {
                  "event_type": {
                    "type": "string",
                    "enum": ["google_tts", "google_music", "google_video"]
                  },
                  "client_payload": {"$ref": "#/components/schemas/MediaPayload"}
                }
              }
            }
          }
        },
        "responses": {
          "204": {"description": "GitHub 已接受任务。继续用 getMediaStatus 查询，不要重复 POST。"},
          "401": {"description": "GitHub PAT 无效。"},
          "403": {"description": "GitHub PAT 权限不足。"},
          "422": {"description": "请求参数无效。"}
        }
      }
    },
    "/repos/no9u93nuong2445-spec/doubao-tts-bridge/commits": {
      "get": {
        "operationId": "getMediaStatus",
        "summary": "查询媒体任务持久状态",
        "description": "使用 path=.gpt-media-status/{request_id}.json、sha=main、per_page=1。若数组为空，说明任务刚被接受但状态尚未写入，不代表失败，也不得重新提交。数组非空时读取第一项 commit.message；其格式为 GPT_MEDIA_STATUS 后跟紧凑 JSON。",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\.gpt-media-status/[A-Za-z0-9._-]{4,100}\\.json$"
            },
            "description": "当前 request_id 的状态路径，例如 .gpt-media-status/gpt-20260817-010203-a1b2.json。"
          },
          {
            "name": "sha",
            "in": "query",
            "required": false,
            "schema": {"type": "string", "default": "main"}
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 1, "default": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "状态文件相关的最近提交。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/StatusCommit"}
                }
              }
            }
          },
          "401": {"description": "GitHub PAT 无效。"},
          "403": {"description": "GitHub PAT 权限不足。"}
        }
      }
    }
  },
  "security": [
    {"bearerAuth": []}
  ],
  "components": {
    "schemas": {
      "MediaPayload": {
        "type": "object",
        "required": ["request_id"],
        "properties": {
          "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{4,100}$"},
          "text": {"type": "string", "maxLength": 12000},
          "voice": {"type": "string"},
          "style": {"type": "string"},
          "tts_mode": {"type": "string", "enum": ["latest", "fast", "pro"]},
          "prompt": {"type": "string", "maxLength": 12000},
          "mode": {"type": "string", "enum": ["clip", "pro"]},
          "video_mode": {"type": "string", "enum": ["omni", "veo", "veo_fast", "veo_lite"]},
          "model": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-tts-preview",
              "gemini-2.5-flash-preview-tts",
              "gemini-2.5-pro-preview-tts",
              "lyria-3-clip-preview",
              "lyria-3-pro-preview",
              "gemini-omni-flash-preview",
              "veo-3.1-generate-preview",
              "veo-3.1-fast-generate-preview",
              "veo-3.1-lite-generate-preview"
            ]
          },
          "aspect_ratio": {"type": "string", "enum": ["16:9", "9:16"]},
          "duration_seconds": {"type": "integer", "minimum": 3, "maximum": 10},
          "resolution": {"type": "string", "enum": ["720p", "1080p", "4k"]},
          "output_name": {"type": "string"}
        }
      },
      "StatusCommit": {
        "type": "object",
        "properties": {
          "sha": {"type": "string"},
          "html_url": {"type": "string"},
          "commit": {
            "type": "object",
            "properties": {
              "message": {"type": "string"},
              "author": {
                "type": "object",
                "properties": {"date": {"type": "string"}}
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer"}
    }
  }
}
