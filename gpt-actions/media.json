{
  "openapi": "3.1.0",
  "info": {
    "title": "彼岸 AI 媒体任务网关",
    "version": "2.3.0",
    "description": "通过 GitHub Issue 提交和查询 Google 语音、音乐、视频任务。"
  },
  "servers": [
    {"url": "https://api.github.com"}
  ],
  "paths": {
    "/repos/no9u93nuong2445-spec/doubao-tts-bridge/issues": {
      "post": {
        "operationId": "submitMediaJob",
        "summary": "提交一个媒体生成任务",
        "description": "创建标题格式为 [GPT_MEDIA] request_id 的 GitHub Issue。body 必须是媒体任务 JSON 字符串。成功创建后返回 issue number，后续只能查询该 issue，不得用同一 request_id 再次提交。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title", "body"],
                "properties": {
                  "title": {
                    "type": "string",
                    "pattern": "^\\[GPT_MEDIA\\] [A-Za-z0-9._-]{4,100}$",
                    "description": "格式必须是 [GPT_MEDIA] request_id。"
                  },
                  "body": {
                    "type": "string",
                    "description": "媒体任务 JSON 字符串。"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "任务 Issue 已创建。",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/MediaIssue"}
              }
            }
          },
          "401": {"description": "GitHub PAT 无效。"},
          "403": {"description": "GitHub PAT 缺少 Issues 写权限。"},
          "422": {"description": "Issue 参数无效。"}
        }
      }
    },
    "/repos/no9u93nuong2445-spec/doubao-tts-bridge/issues/{issue_number}": {
      "get": {
        "operationId": "getMediaJob",
        "summary": "查询媒体任务状态和结果",
        "parameters": [
          {
            "name": "issue_number",
            "in": "path",
            "required": true,
            "schema": {"type": "integer", "minimum": 1}
          }
        ],
        "responses": {
          "200": {
            "description": "媒体任务 Issue。body 是紧凑 JSON 状态对象。",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/MediaIssue"}
              }
            }
          },
          "401": {"description": "GitHub PAT 无效。"},
          "403": {"description": "GitHub PAT 缺少 Issues 读权限。"},
          "404": {"description": "找不到该任务。"}
        }
      }
    }
  },
  "security": [
    {"bearerAuth": []}
  ],
  "components": {
    "schemas": {
      "MediaIssue": {
        "type": "object",
        "properties": {
          "number": {"type": "integer"},
          "state": {"type": "string"},
          "title": {"type": "string"},
          "body": {"type": "string"},
          "html_url": {"type": "string"}
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
