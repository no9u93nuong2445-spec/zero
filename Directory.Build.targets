<Project>
  <Target Name="ApplyAIVideoHubV22CanonicalFix" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'AI.VideoHub'">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)ai-video-hub-v2.2-build-tools\apply_canonical_fix.py&quot;" WorkingDirectory="$(MSBuildThisFileDirectory)" />
  </Target>
</Project>
